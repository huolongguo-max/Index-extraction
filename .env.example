# ===========================================
# Index-extraction 环境配置模板
# 复制此文件为 .env.development 或 .env.production 使用
# ===========================================

# -------------------- 应用基础 --------------------
# 应用名称
APP_NAME=Index-extraction
# 运行环境：development | production
APP_ENV=development
# 调试模式：true | false
DEBUG=true

# -------------------- 前端服务 --------------------
# 前端开发服务器端口
VITE_DEV_PORT=5173
# 前端开发服务器主机
VITE_DEV_HOST=localhost
# 前端API请求基础地址（后端服务地址）
VITE_API_BASE_URL=http://localhost:18000
# SSE实时数据流地址
VITE_SSE_URL=http://localhost:18000/api/sse

# -------------------- 后端服务 --------------------
# FastAPI服务端口
BACKEND_PORT=18000
# FastAPI服务主机
BACKEND_HOST=0.0.0.0
# 是否自动重载（开发模式）
BACKEND_RELOAD=true
# 工作进程数（生产环境）
BACKEND_WORKERS=4

# -------------------- Chrome浏览器配置 --------------------
# 浏览器运行模式：headless（静默）| gui（图形界面）
CHROME_MODE=headless
# Chrome浏览器路径（留空则使用系统默认）
CHROME_BINARY_PATH=
# 页面加载超时时间（秒）
CHROME_PAGE_LOAD_TIMEOUT=30
# 元素等待超时时间（秒）
CHROME_ELEMENT_TIMEOUT=10
# 静默模式下窗口大小（宽x高）
CHROME_WINDOW_SIZE=1920,1080
# 浏览器缓存目录
CHROME_CACHE_DIR=./browser-cache
# 是否禁用图片加载（加速）
CHROME_DISABLE_IMAGES=true

# -------------------- RPA抓取配置 --------------------
# 抓取重试次数
RPA_MAX_RETRIES=3
# 抓取重试间隔（秒）
RPA_RETRY_INTERVAL=2
# XPath规则配置文件路径
RPA_XPATH_CONFIG_PATH=./config/xpath_rules.json
# 默认抓取超时（秒）
RPA_FETCH_TIMEOUT=60
# 表格数据缓存文件路径
RPA_CACHE_FILE_PATH=./static/cache/table_data.json

# -------------------- SSE实时推送配置 --------------------
# SSE心跳间隔（秒）
SSE_HEARTBEAT_INTERVAL=15
# SSE数据推送间隔（秒）
SSE_PUSH_INTERVAL=5

# -------------------- 桌面悬浮窗配置 --------------------
# 悬浮窗默认宽度（像素）
DESKTOP_WINDOW_WIDTH=400
# 悬浮窗默认高度（像素）
DESKTOP_WINDOW_HEIGHT=600
# 悬浮窗默认位置（x,y）
DESKTOP_WINDOW_POSITION=100,100
# 悬浮窗默认透明度（0.0~1.0）
DESKTOP_WINDOW_OPACITY=0.95
# 悬浮窗刷新间隔（秒）
DESKTOP_REFRESH_INTERVAL=3

# -------------------- 日志配置 --------------------
# 日志级别：DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=DEBUG
# 日志文件保存路径
LOG_DIR=./logs
# 单日志文件最大大小（MB）
LOG_MAX_SIZE=10
# 日志文件保留天数
LOG_RETENTION_DAYS=7
